<?xml version="1.0" encoding="utf-8"?>
<!-- Cocoon: leaving a game, it shrinks down into its suspended card. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:zAdjustment="top"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <scale
        android:fromXScale="1.0" android:toXScale="0.62"
        android:fromYScale="1.0" android:toYScale="0.62"
        android:pivotX="50%" android:pivotY="50%"
        android:duration="300" />
    <alpha android:startOffset="120" android:fromAlpha="1.0" android:toAlpha="0.0" android:duration="180" />
</set>
